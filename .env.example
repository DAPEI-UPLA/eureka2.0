# Copia este archivo como `.env` y completa los valores.
# En producción, DJANGO_SECRET_KEY es OBLIGATORIA.

# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Activar solo en desarrollo local. En producción debe quedar en False.
DJANGO_DEBUG=True

# Hosts permitidos, separados por coma (ej: midominio.cl,www.midominio.cl)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes de confianza para CSRF tras proxy/HTTPS (ej: https://midominio.cl)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Poner en False SOLO si el sitio se sirve por HTTP plano (ej. IP de red interna
# sin certificado). Con True (default) se fuerza HTTPS y cookies seguras.
DJANGO_SECURE_SSL_REDIRECT=True

# Nivel de logging de Django (DEBUG, INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=INFO
